<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opensource.backend.resource.ResourceMapper">
    <select id="findClusters" resultType="com.opensource.backend.resource.Resource">
      <!-- TODO: CLUSTER만, id 순서로 -->
      SELECT
        id,
        type,
        name,
        status,
        phase,
        parent_id,
        path,
        updated_at,
        cpu,
        memory,
        restarts
      FROM resource
      WHERE type = 'CLUSTER'
      ORDER BY id
    </select>
</mapper>